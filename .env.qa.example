# Copy to .env on the QA VPS. Never commit .env. Used by docker-compose.qa.yml.

# Generate a real one, don't reuse the dev key or any other environment's:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# The VPS's IP (or a QA subdomain, once DNS points at it), comma-separated --
# plus 127.0.0.1 and localhost, which the two health checks call the app by
# (docker-compose.qa.yml's container check and deploy/deploy.sh). Without them
# every deploy is refused as unhealthy. E.g.:
#   DJANGO_ALLOWED_HOSTS=97.74.81.23,127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=

# Only needed once this sits behind a domain the browser can send a CSRF
# Origin header for -- can stay empty for bare IP:port access.
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=Asia/Dubai

# Plain HTTP until this QA deployment has a domain + TLS in front of it --
# see docker-compose.qa.yml's comment on DJANGO_FORCE_HTTPS before changing.
DJANGO_FORCE_HTTPS=0

# A real password -- this one is reachable only from the `web` container
# (docker-compose.qa.yml publishes no db port), but don't reuse the dev
# default anyway.
POSTGRES_DB=byky_qa
POSTGRES_USER=byky_qa
POSTGRES_PASSWORD=

# A copy of every device API request for the central log server (the
# log-ingestion project), sent from a background thread after it is saved here.
# Leave both empty to send nothing. The key is this project's ingest key on
# that server (its scripts/add_project.py prints it). E.g.:
#   LOG_INGEST_URL=https://logs.softlandindia.net/ingest/batch
LOG_INGEST_URL=
LOG_INGEST_KEY=
